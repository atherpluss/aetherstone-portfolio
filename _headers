# Cloudflare Pages — en-têtes de sécurité et de cache.
# Doc : https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Empêche le navigateur de deviner un type MIME (protège des uploads piégés).
  X-Content-Type-Options: nosniff
  # Interdit l'affichage du site dans une iframe tierce (clickjacking).
  X-Frame-Options: DENY
  # Ne transmet l'URL complète qu'en interne ; l'origine seule vers l'extérieur.
  Referrer-Policy: strict-origin-when-cross-origin
  # Coupe l'accès aux capteurs et périphériques dont le site n'a aucun usage.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # Force le HTTPS pendant 2 ans, sous-domaines compris.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # CSP : 'unsafe-inline' reste nécessaire tant que les scripts et styles sont
  # embarqués dans les pages. Le durcir suppose de les externaliser d'abord.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://player.vimeo.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://formsubmit.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://player.vimeo.com https://splendid-kitsune-85e291.netlify.app; base-uri 'self'; form-action 'self' https://formsubmit.co https://checkout.stripe.com; object-src 'none'; upgrade-insecure-requests

# Assets versionnés/immuables : cache long.
/wf/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Code : pas d'empreinte dans les noms de fichiers, donc revalidation a chaque
# visite (304 si inchange). Evite qu'une mise en ligne reste invisible.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# HTML : jamais servi périmé.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
